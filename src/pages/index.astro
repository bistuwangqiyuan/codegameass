---
import Layout from '../components/Layout.astro';
import DemoLoginSection from '../components/react/DemoLoginSection';
import BistuProgramBadge from '../components/BistuProgramBadge.astro';
import { pageTitle, BRAND, SCHOOL_INTRO } from '../lib/branding';
---

<Layout title={pageTitle()} currentPath="/">
  <div class="bg-bistu-gradient min-h-screen">
    <!-- Hero -->
    <section class="relative overflow-hidden px-4 py-16 md:py-24">
      <div class="absolute inset-0 -z-10">
        <img src={BRAND.campusBanner} alt={BRAND.university} class="h-full w-full border-0 object-cover opacity-20" />
        <div class="absolute inset-0 bg-gradient-to-b from-bistu-primary/10 to-transparent"></div>
      </div>

      <div class="mx-auto max-w-7xl text-center">
        <img src={BRAND.logo} alt={BRAND.university} class="brand-logo mx-auto mb-6 h-24 w-24 drop-shadow-lg" />
        <p class="mb-3 text-sm font-medium tracking-wide text-bistu-accent">{BRAND.university}</p>
        <div class="mb-4 flex justify-center">
          <BistuProgramBadge size="md" />
        </div>
        <h1 class="mb-4 text-4xl font-extrabold text-gray-900 md:text-6xl">
          <span class="text-bistu-gradient">{BRAND.name}</span>
        </h1>
        <p class="mb-2 text-xl font-semibold text-gray-700 md:text-2xl">{BRAND.subtitle}</p>
        <p class="mx-auto mb-8 max-w-2xl text-lg text-gray-600">
          {BRAND.programLabel} — 面向信息科大大学生的游戏化 Web 编程学习平台 · {BRAND.programTag} 实时辅导 · 闯关挑战 · 作品社区
        </p>

        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <div id="heroDemoLogin">
            <DemoLoginSection client:load compact />
          </div>
          <a href="#features" class="rounded-xl border-2 border-bistu-primary/30 bg-white px-8 py-3 font-semibold text-bistu-primary shadow-md transition hover:border-bistu-primary hover:shadow-lg no-underline hover:no-underline">
            了解更多
          </a>
        </div>

        <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm">
          {['AI 实时辅导', '游戏化闯关', '在线编码沙盒', '成就系统'].map((tag) => (
            <div class="flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-md">
              <span class="font-medium text-gray-700">{tag}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 测试账号 -->
    <section id="demo-accounts" class="px-4 py-16">
      <div class="mx-auto max-w-5xl">
        <div class="mb-8 text-center">
          <h2 class="mb-3 text-3xl font-bold text-bistu-primary">🎓 测试账号体验</h2>
          <p class="text-gray-600">无需注册，使用以下公开测试账号即可体验全部功能</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow-xl">
          <DemoLoginSection client:load />
        </div>
        <p class="mt-4 text-center text-xs text-gray-500">
          密码均为 <code class="rounded bg-gray-100 px-1">BistuDemo2026</code> · 推荐首次使用「学生」账号
        </p>
      </div>
    </section>

    <!-- 学校简介 -->
    <section id="about" class="bg-white px-4 py-16">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 text-center">
          <h2 class="mb-3 text-3xl font-bold text-bistu-primary">{SCHOOL_INTRO.title}</h2>
        </div>
        <div class="mb-10 grid gap-6 md:grid-cols-2">
          {SCHOOL_INTRO.paragraphs.map((p) => (
            <p class="text-gray-700 leading-relaxed">{p}</p>
          ))}
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {SCHOOL_INTRO.highlights.map((h) => (
            <div class="rounded-xl border border-bistu-primary/10 bg-bistu-bg p-6 text-center">
              <div class="mb-2 text-3xl">{h.icon}</div>
              <div class="font-bold text-bistu-primary">{h.label}</div>
              <div class="mt-1 text-sm text-gray-600">{h.desc}</div>
            </div>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href={BRAND.website} target="_blank" rel="noopener noreferrer" class="text-bistu-primary font-medium no-underline hover:underline">
            访问 {BRAND.university} 官网 →
          </a>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="px-4 py-16">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">为什么选择 {BRAND.name}？</h2>
          <p class="text-lg text-gray-600">专为信息科大大学生设计的创新学习方式</p>
        </div>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {[
            { icon: '🎮', title: `${BRAND.program} · ${BRAND.programTag}`, desc: '信工实习与 AI 编程相结合的游戏化学习体系：闯关、任务与 Boss 挑战，在实习场景中掌握 Web 开发技能。', color: 'from-bistu-primary to-bistu-primary-light' },
            { icon: '🤖', title: BRAND.aiAssistant, desc: 'DeepSeek 驱动的 AI 助教，提供实时代码讲解、错误诊断，举例贴近信息科大校园场景。', color: 'from-bistu-accent to-bistu-accent-light' },
            { icon: '💻', title: '在线代码编辑器', desc: '内置专业编辑器，HTML/CSS/JavaScript 实时预览，在浏览器中完成所有实验。', color: 'from-bistu-primary to-bistu-accent' },
            { icon: '📚', title: '系统化课程', desc: '从新生欢迎页到综合实战，课程案例融入信息学院与计算机专业学习场景。', color: 'from-bistu-gold to-yellow-600' },
            { icon: '🏆', title: '成就与排行榜', desc: '解锁成就徽章，与信息科大同学竞争排名，激发学习动力。', color: 'from-bistu-accent to-red-700' },
            { icon: '🎨', title: '同学作品墙', desc: '分享校园主题 Web 作品，获得点赞与评论，共同进步成长。', color: 'from-bistu-primary-light to-purple-600' },
          ].map((f) => (
            <div class="rounded-2xl bg-white p-8 shadow-lg transition hover:shadow-xl">
              <div class={`mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br ${f.color} text-2xl text-white shadow-lg`}>
                {f.icon}
              </div>
              <h3 class="mb-3 text-xl font-bold text-gray-900">{f.title}</h3>
              <p class="text-gray-600">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 学习路径 -->
    <section class="bg-white px-4 py-16">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold text-gray-900">学习路径</h2>
          <p class="text-lg text-gray-600">面向信息学院 · 计算机相关专业的循序渐进路线</p>
        </div>
        <div class="space-y-6">
          {[
            { n: 1, title: 'HTML5 基础', desc: '搭建信息科大新生欢迎页，学习网页结构', color: 'bg-bistu-primary' },
            { n: 2, title: 'CSS 样式设计', desc: '设计校园社团活动海报，掌握布局与动画', color: 'bg-bistu-primary-light' },
            { n: 3, title: 'JavaScript 基础', desc: '制作课程表查询小工具，学习 JS 核心语法', color: 'bg-bistu-gold' },
            { n: 4, title: 'DOM 操作', desc: '为校园活动页添加动态交互功能', color: 'bg-green-600' },
            { n: 5, title: '综合实战', desc: '完成信息科大主题完整 Web 项目', color: 'bg-bistu-accent' },
          ].map((level) => (
            <div class="flex items-center gap-4 rounded-xl border border-gray-100 bg-gray-50 p-6">
              <div class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-full ${level.color} text-lg font-bold text-white`}>
                {level.n}
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900">{level.title}</h3>
                <p class="text-gray-600">{level.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-4 py-16">
      <div class="mx-auto max-w-4xl text-center">
        <div class="rounded-3xl bg-bistu-hero p-12 shadow-2xl">
          <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">准备开始你的编程之旅了吗？</h2>
          <p class="mb-8 text-xl text-white/90">{BRAND.programLabel} — 使用测试账号，立即体验全部功能</p>
          <DemoLoginSection client:load compact variant="light" />
          <p class="mt-6 text-sm text-white/75">• 公开测试账号 • 全部课程 • {BRAND.aiAssistant} 全程陪伴</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  window.addEventListener('open-auth-modal', () => {});
</script>
