---
import Layout from '../components/Layout.astro';
import BistuProgramBadge from '../components/BistuProgramBadge.astro';
import { pageTitle, BRAND } from '../lib/branding';

export const prerender = true;
---

<Layout title={pageTitle('系统诊断')} currentPath="/diagnostic">
  <div class="min-h-screen bg-bistu-bg py-12">
    <div class="mx-auto max-w-4xl px-4">
      <div class="mb-6 flex items-center gap-4">
        <img src={BRAND.logo} alt="" class="brand-logo h-12 w-12" />
        <div>
          <div class="mb-2"><BistuProgramBadge size="sm" /></div>
          <h1 class="text-3xl font-bold text-bistu-primary">系统诊断</h1>
          <p class="text-gray-600">{BRAND.programLabel} · {BRAND.name} · Neon 数据库检测</p>
        </div>
      </div>
      <div class="rounded-2xl bg-white p-8 shadow-lg">
        <div class="mb-4 flex flex-wrap gap-3">
          <button id="runDiagnostic" class="btn-bistu-primary">运行诊断测试</button>
          <button id="initDatabase" class="rounded-lg border border-bistu-primary px-4 py-2 text-bistu-primary hover:bg-bistu-primary/5">
            初始化数据库
          </button>
        </div>
        <div id="diagnosticResults" class="mt-6 space-y-4"></div>
      </div>

      <div id="fixGuide" class="mt-8 hidden rounded-2xl bg-yellow-50 p-8 shadow-lg">
        <h2 class="mb-4 text-2xl font-bold text-yellow-900">修复指南</h2>
        <div id="fixInstructions"></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // @ts-nocheck
  const button = document.getElementById('runDiagnostic');
  const initBtn = document.getElementById('initDatabase');
  const results = document.getElementById('diagnosticResults');
  const fixGuide = document.getElementById('fixGuide');
  const fixInstructions = document.getElementById('fixInstructions');

  async function runDiagnostic() {
    results.innerHTML = '<div class="text-gray-600">正在运行诊断...</div>';

    try {
      const response = await fetch('/api/health');
      const data = await response.json();

      let html = '<div class="space-y-4">';

      const isOk = data.status === 'ok';
      html += `
        <div class="flex items-center gap-3 rounded-lg border p-4 ${isOk ? 'border-green-200 bg-green-50' : 'border-red-200 bg-red-50'}">
          <div class="text-2xl">${isOk ? '✅' : '❌'}</div>
          <div>
            <div class="font-semibold ${isOk ? 'text-green-900' : 'text-red-900'}">
              ${isOk ? 'Neon 数据库连接正常' : data.status === 'needs_init' ? '数据库已连接，需要初始化' : '数据库连接失败'}
            </div>
            ${data.hint ? `<p class="mt-1 text-sm text-gray-600">${data.hint}</p>` : ''}
          </div>
        </div>
      `;

      html += `
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
          <div class="mb-2 font-semibold text-gray-900">数据库类型</div>
          <code class="text-sm text-gray-700">${data.database || 'unknown'} (${data.connectionSource || 'n/a'})</code>
        </div>
      `;

      html += `
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
          <div class="mb-2 font-semibold text-gray-900">AUTH_SECRET</div>
          <div class="${data.authSecretSet ? 'text-green-600' : 'text-orange-600'}">
            ${data.authSecretSet ? '✓ 已设置' : '⚠ 未设置（使用开发默认值，生产环境请配置）'}
          </div>
        </div>
      `;

      html += `
        <div class="grid gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
            <div class="text-sm text-gray-500">已发布课程</div>
            <div class="text-2xl font-bold text-bistu-primary">${data.courseCount ?? 0}</div>
          </div>
          <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
            <div class="text-sm text-gray-500">公开作品</div>
            <div class="text-2xl font-bold text-bistu-primary">${data.projectCount ?? 0}</div>
          </div>
        </div>
      `;

      if (data.databaseError) {
        html += `
          <div class="rounded-lg border border-red-200 bg-red-50 p-4">
            <div class="mb-2 font-semibold text-red-900">数据库错误</div>
            <div class="text-sm">${data.databaseError.message}</div>
          </div>
        `;

        fixGuide.classList.remove('hidden');
        fixInstructions.innerHTML = `
          <div class="space-y-4 text-yellow-900">
            <p class="font-semibold">数据库表可能尚未创建</p>
            <ol class="list-decimal space-y-2 pl-5">
              <li>确认 Netlify 已连接 Neon 数据库扩展</li>
              <li>点击上方「初始化数据库」按钮，或执行 <code class="rounded bg-gray-200 px-2 py-1">POST /api/db/init</code></li>
              <li>在 Netlify 环境变量中设置 <code class="rounded bg-gray-200 px-2 py-1">AUTH_SECRET</code>（≥32 字符）</li>
              <li>重新运行诊断</li>
            </ol>
          </div>
        `;
      } else if (data.status === 'needs_init') {
        fixGuide.classList.remove('hidden');
        fixInstructions.innerHTML = `
          <p class="text-yellow-900">数据库已连接但尚无课程数据，请点击「初始化数据库」。</p>
        `;
      } else {
        fixGuide.classList.add('hidden');
      }

      html += '</div>';
      results.innerHTML = html;
    } catch (error) {
      results.innerHTML = `
        <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-900">
          <div class="font-semibold">诊断失败</div>
          <div class="mt-2 text-sm">${error.message}</div>
        </div>
      `;
    }
  }

  button?.addEventListener('click', runDiagnostic);

  initBtn?.addEventListener('click', async () => {
    initBtn.setAttribute('disabled', 'true');
    initBtn.textContent = '初始化中...';
    try {
      const res = await fetch('/api/db/init', { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        await runDiagnostic();
      } else {
        results.innerHTML = `<div class="text-red-600">初始化失败: ${data.error}</div>`;
      }
    } catch (e) {
      results.innerHTML = `<div class="text-red-600">初始化失败: ${e.message}</div>`;
    } finally {
      initBtn.removeAttribute('disabled');
      initBtn.textContent = '初始化数据库';
    }
  });
</script>
