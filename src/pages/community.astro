---
import Layout from '../components/Layout.astro';
import DemoLoginSection from '../components/react/DemoLoginSection';
import BistuProgramBadge from '../components/BistuProgramBadge.astro';
import { pageTitle, BRAND } from '../lib/branding';
---

<Layout title={pageTitle('作品社区')} currentPath="/community" fullWidth>
  <div class="min-h-screen bg-bistu-bg">
    <div id="loginBanner" class="border-b border-bistu-primary/20 bg-bistu-primary/5 px-4 py-3">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-bistu-primary">{BRAND.programLabel} — 登录后可发布作品、点赞与评论</p>
        <DemoLoginSection client:load compact />
      </div>
    </div>

    <section class="bg-bistu-hero px-4 py-12 text-white">
      <div class="mx-auto max-w-7xl text-center">
        <img src={BRAND.logo} alt="" class="brand-logo mx-auto mb-4 h-16 w-16 opacity-90" />
        <div class="mb-4 flex justify-center"><BistuProgramBadge size="md" /></div>
        <h1 class="mb-4 text-4xl font-bold">信息科大同学作品墙</h1>
        <p class="text-xl text-white/90">
          {BRAND.programLabel} 作品展示 — 分享校园主题 Web 作品，发现信息科大同学的精彩创意
        </p>
        <button
          id="createProjectBtn"
          class="mt-6 rounded-lg bg-white px-6 py-2 font-semibold text-bistu-primary transition hover:bg-gray-100"
        >
          ✨ 发布作品
        </button>
      </div>
    </section>

    <div class="sticky top-[57px] z-30 border-b border-gray-200 bg-white py-4">
      <div class="mx-auto max-w-7xl px-4">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap gap-2">
            {['全部', 'HTML5', 'CSS 动画', 'JavaScript', '校园工具', '社团页面'].map((tag, i) => (
              <button class:list={[
                'rounded-full px-4 py-2 text-sm font-medium transition',
                i === 0 ? 'bg-bistu-primary/10 text-bistu-primary' : 'bg-gray-100 text-gray-700 hover:bg-gray-200',
              ]}>
                {tag}
              </button>
            ))}
          </div>
          <select id="sortSelect" class="rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-bistu-primary focus:outline-none">
            <option value="latest">最新发布</option>
            <option value="popular">最受欢迎</option>
            <option value="views">浏览最多</option>
            <option value="ai_score">AI 评分</option>
          </select>
        </div>
      </div>
    </div>

    <section class="px-4 py-8">
      <div class="mx-auto max-w-7xl">
        <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold text-bistu-primary">
          <span>⭐</span> 本周精选 · 信息科大主题
        </h2>
        <div id="featuredProjectsContainer" class="grid gap-6 md:grid-cols-3"></div>
      </div>
    </section>

    <section class="px-4 py-8">
      <div class="mx-auto max-w-7xl">
        <h2 class="mb-6 text-2xl font-bold text-gray-900">探索更多作品</h2>
        <div id="projectsContainer" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"></div>
        <div class="mt-8 text-center">
          <button id="loadMoreBtn" class="rounded-lg bg-gray-200 px-6 py-3 font-medium text-gray-700 transition hover:bg-gray-300">
            加载更多
          </button>
        </div>
      </div>
    </section>

    <section class="bg-gradient-to-br from-bistu-bg to-white px-4 py-8">
      <div class="mx-auto max-w-7xl">
        <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold text-gray-900">
          <span>🤖</span> {BRAND.aiAssistant} 推荐今日必看
        </h2>
        <div id="aiRecommendedContainer" class="grid gap-6 md:grid-cols-2"></div>
      </div>
    </section>
  </div>

  <div id="projectModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/50 backdrop-blur-sm">
    <div class="flex min-h-screen items-center justify-center p-4">
      <div id="projectModalContent" class="w-full max-w-6xl rounded-2xl bg-white p-8 shadow-2xl"></div>
    </div>
  </div>
</Layout>

<script>
  // @ts-nocheck
  import { supabase } from '../lib/supabase';

  let currentPage = 1;
  const pageSize = 12;

  document.getElementById('createProjectBtn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-auth-modal', { detail: { mode: 'demo' } }));
  });

  async function loadProjects(page = 1, sortBy = 'latest') {
    const container = document.getElementById('projectsContainer');
    if (!container) return;

    try {
      let query = supabase
        .from('user_projects')
        .select('*')
        .eq('is_public', true)
        .range((page - 1) * pageSize, page * pageSize - 1);

      switch (sortBy) {
        case 'latest': query = query.order('created_at', { ascending: false }); break;
        case 'popular': query = query.order('likes_count', { ascending: false }); break;
        case 'views': query = query.order('views_count', { ascending: false }); break;
        case 'ai_score': query = query.order('ai_score', { ascending: false, nullsFirst: false }); break;
      }

      const { data: projects, error } = await query;
      if (error) throw error;

      if (projects && projects.length > 0) {
        if (page === 1) container.innerHTML = '';
        projects.forEach((project) => {
          const card = document.createElement('div');
          card.className = 'rounded-xl border border-bistu-primary/10 bg-white p-6 shadow-md transition hover:shadow-lg cursor-pointer';
          card.innerHTML = `
            <div class="mb-2 text-xs text-bistu-accent font-medium">{BRAND.programLabel} 作品</div>
            <h3 class="text-xl font-bold mb-2 text-bistu-primary">${project.title}</h3>
            <p class="text-gray-600 mb-4 text-sm">${project.description || ''}</p>
            <div class="flex items-center gap-4 text-sm text-gray-500">
              <span>❤️ ${project.likes_count}</span>
              <span>👁️ ${project.views_count}</span>
              <span>💬 ${project.comments_count}</span>
            </div>
          `;
          card.onclick = () => showProjectDetail(project);
          container.appendChild(card);
        });

        if (page === 1 && projects.length >= 3) {
          const featured = document.getElementById('featuredProjectsContainer');
          if (featured) {
            featured.innerHTML = projects.slice(0, 3).map((p) => `
              <div class="rounded-xl bg-white p-6 shadow-lg border-l-4 border-bistu-accent">
                <h3 class="font-bold text-bistu-primary">${p.title}</h3>
                <p class="mt-2 text-sm text-gray-600">${p.description || ''}</p>
              </div>
            `).join('');
          }
        }
      } else if (page === 1) {
        container.innerHTML = '<p class="col-span-full text-gray-500 text-center py-8">暂无作品，使用测试账号登录后可发布信息科大主题作品</p>';
      }
    } catch (error) {
      console.error('Error loading projects:', error);
    }
  }

  function showProjectDetail(project) {
    const modal = document.getElementById('projectModal');
    const content = document.getElementById('projectModalContent');
    if (!modal || !content) return;

    content.innerHTML = `
      <button onclick="document.getElementById('projectModal').classList.add('hidden')" class="absolute right-8 top-8 text-gray-400 hover:text-gray-600">✕</button>
      <h2 class="mb-2 text-3xl font-bold text-bistu-primary">${project.title}</h2>
      <p class="mb-6 text-gray-600">${project.description || ''}</p>
      <div class="rounded-xl border bg-gray-50 p-8 text-center text-gray-500">作品预览</div>
      <div class="mt-4 flex gap-4 text-sm text-gray-500">
        <span>❤️ ${project.likes_count}</span>
        <span>👁️ ${project.views_count}</span>
      </div>
    `;
    modal.classList.remove('hidden');
  }

  document.getElementById('sortSelect')?.addEventListener('change', (e) => {
    currentPage = 1;
    loadProjects(1, e.target.value);
  });

  document.getElementById('loadMoreBtn')?.addEventListener('click', () => {
    currentPage++;
    loadProjects(currentPage);
  });

  document.addEventListener('DOMContentLoaded', () => loadProjects(1));
</script>
