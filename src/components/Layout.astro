---
import "../../src/styles/globals.css";
import BistuNav from "./BistuNav.astro";
import BistuFooter from "./BistuFooter.astro";
import AppProviders from "./react/AppProviders";
import { BRAND } from "../lib/branding";

interface Props {
  title: string;
  showNav?: boolean;
  showFooter?: boolean;
  fullWidth?: boolean;
  currentPath?: string;
}

const {
  title,
  showNav = true,
  showFooter = true,
  fullWidth = false,
  currentPath = "",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={BRAND.subtitle} />
    <meta name="keywords" content="信工实习,AI编程,北京信息科技大学,信息科大,Web编程,HTML,CSS,JavaScript,大学生" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    {showNav && <BistuNav currentPath={currentPath} />}
    <main class:list={["flex-1 w-full", !fullWidth && "mx-auto max-w-7xl"]}>
      <slot />
    </main>
    {showFooter && <BistuFooter />}
    <AppProviders client:load />
  </body>
</html>
