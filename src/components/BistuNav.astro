---
import { BRAND } from '../lib/branding';
import BistuProgramBadge from './BistuProgramBadge.astro';
import NavAuthButton from './react/NavAuthButton';

interface Props {
  currentPath?: string;
}
const { currentPath = '' } = Astro.props;

const navItems = [
  { href: '/', label: '首页' },
  { href: '/learn', label: '学习中心' },
  { href: '/community', label: '作品社区' },
  { href: '/#about', label: '关于学校' },
  { href: '/diagnostic', label: '系统诊断' },
];
---

<header class="sticky top-0 z-50 border-b border-bistu-primary/10 bg-white/95 shadow-sm backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
    <a href="/" class="flex items-center gap-3 no-underline hover:no-underline">
      <img src={BRAND.logo} alt={BRAND.university} class="brand-logo h-10 w-10" />
      <div class="hidden sm:block">
        <div class="text-lg font-bold text-bistu-primary">{BRAND.name}</div>
        <BistuProgramBadge size="sm" />
      </div>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-medium no-underline transition hover:no-underline',
            currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href.replace('/#about', '')))
              ? 'bg-bistu-primary/10 text-bistu-primary'
              : 'text-gray-600 hover:bg-gray-100 hover:text-bistu-primary',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={BRAND.website}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-lg border border-bistu-primary/20 px-3 py-1.5 text-xs text-bistu-primary no-underline hover:bg-bistu-primary/5 hover:no-underline lg:inline-block"
      >
        学校官网
      </a>
      <NavAuthButton client:load />
    </div>
  </div>
</header>

<!-- 移动端导航 -->
<nav class="border-b border-gray-100 bg-white px-4 py-2 md:hidden">
  <div class="mb-2 flex justify-center">
    <BistuProgramBadge size="sm" />
  </div>
  <div class="flex gap-2 overflow-x-auto">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="whitespace-nowrap rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 no-underline hover:bg-bistu-primary/10 hover:text-bistu-primary hover:no-underline"
      >
        {item.label}
      </a>
    ))}
  </div>
</nav>
